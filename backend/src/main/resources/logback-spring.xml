<?xml version="1.0" encoding="UTF-8"?>
<!--
  Every log line carries the correlation id established by CorrelationIdFilter, so a single
  request can be traced end to end and a user-reported id leads straight to it.
-->
<configuration>

    <property name="CONSOLE_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%X{correlationId:-no-correlation-id}] %logger{36} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_PATTERN}</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

    <logger name="com.rescrm" level="INFO"/>
    <logger name="org.flywaydb" level="INFO"/>

</configuration>
